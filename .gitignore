# SCons build cache
*.sconsign.dblite
*.pyc

# Per-step build artifacts (regenerated by SCons)
*/output/
*/input-data/
*/temp/

# Environment variables (API keys, etc.)
.env

# Stata side-effect logs
*.log

# LaTeX build artifacts
*.aux
*.fls
*.fdb_latexmk
*.lof
*.lot
*.nav
*.snm
*.toc
*.out

# Release directory (build artifact)
release/

# LyX backups (legacy)
*.lyx~
*.lyx#
*.lyx.emergency

# R history
*.Rhistory
*.Rapp.history

# User-specific config (unversioned)
*config_user.yaml
!config_user_template.yaml

# macOS
*.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb
